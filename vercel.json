{
  "rewrites": [
    { "source": "/", "destination": "https://portfolio-v2-emmanuelchiefson-gmailcoms-projects.vercel.app/" },
    { "source": "/:path*", "destination": "https://portfolio-v2-emmanuelchiefson-gmailcoms-projects.vercel.app/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
